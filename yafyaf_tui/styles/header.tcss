/* ═══════════════════════════════════════════════════════════════════════
   APP HEADER - what yafyaf adds on the right of tui-kit's
   ═══════════════════════════════════════════════════════════════════════ */

#app-url {
    width: auto;
    color: $yellow;
}

/* The account is the way into Settings with the mouse, so it reads as a link */
#app-account {
    width: auto;
    margin-left: 2;
    color: $blue;
}

#app-account:hover {
    text-style: underline;
}
