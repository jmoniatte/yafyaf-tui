/* ═══════════════════════════════════════════════════════════════════════
   MODAL FORMS
   ═══════════════════════════════════════════════════════════════════════ */

ModalScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

ModalScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

ModalScreen .form-row {
    height: 3;
    align: left middle;
}

ModalScreen .field-label {
    width: 10;
    padding-top: 1;
    color: $fg;
}

ModalScreen Input {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen Input:focus {
    border: solid $blue;
}

ModalScreen #dialog-buttons {
    height: auto;
    align: right middle;
}

ModalScreen Button {
    width: auto;
    min-width: 0;
    margin: 1 0 0 1;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

ModalScreen Button:focus {
    background: $blue;
    color: $bg-dark;
}

ModalScreen Button:disabled {
    color: $comment;
}
