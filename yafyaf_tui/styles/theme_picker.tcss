/* ═══════════════════════════════════════════════════════════════════════
   THEME PICKER
   ═══════════════════════════════════════════════════════════════════════ */

ThemePicker {
    align: center top;
    background: $bg 80%;
}

ThemePicker > Vertical {
    width: 54;
    height: 1fr;
    max-height: 100%;
    margin-top: 2;
    margin-bottom: 2;
}

ThemePicker #theme-filter {
    width: 1fr;
    height: 2;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    color: $fg;
    border: none !important;
    border-bottom: solid $gutter !important;
}

ThemePicker #theme-filter:focus {
    border-bottom: solid $blue !important;
}

ThemePicker #theme-table {
    height: 1fr;
    background: transparent;
    border: none;
    color: $fg;
    scrollbar-size: 0 0;
}

ThemePicker #theme-table > .datatable--cursor {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

ThemePicker #theme-table > .datatable--hover {
    background: transparent;
}

ThemePicker #theme-hint {
    color: $comment;
    margin-top: 1;
    border-top: ascii $gutter;
    padding-top: 1;
}
