/* ═══════════════════════════════════════════════════════════════════════
   LOGIN SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

LoginScreen {
    align: center top;
    background: $bg 80%;
}

LoginScreen #login-url {
    color: $comment;
    margin: 1 0;
}

LoginScreen #login-error {
    height: auto;
    min-height: 1;
    color: $red;
    margin-top: 1;
}
