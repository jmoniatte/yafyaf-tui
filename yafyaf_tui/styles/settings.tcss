/* ═══════════════════════════════════════════════════════════════════════
   PANELS (settings, help)
   ═══════════════════════════════════════════════════════════════════════ */

PanelScreen {
    align: center top;
    background: $bg 80%;
}

PanelScreen > Vertical {
    width: auto;
    min-width: 84;
    max-width: 90;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

/* Settings holds two short rows; only Help needs the room for its two columns */
#settings-panel {
    width: 70;
    min-width: 0;
}

PanelScreen Static {
    color: $fg;
}

PanelScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

PanelScreen #title-separator {
    height: 1;
}

/* A row is the value line and the underline below it; labels and the button sit on the value line */
PanelScreen .settings-row {
    height: 2;
    margin-bottom: 1;
    align: left top;
}

PanelScreen .settings-label {
    width: 10;
    color: $comment;
}

/* Underlined like Flotte's form dropdowns, so it reads as something to open */
PanelScreen Select {
    width: 1fr;
    height: 2;
}

PanelScreen Select SelectCurrent {
    background: transparent;
    border: none !important;
    border-bottom: solid $gutter !important;
    padding: 0 1;
    color: $fg;
}

PanelScreen Select SelectCurrent:hover,
PanelScreen Select:focus SelectCurrent {
    border-bottom: solid $blue !important;
}

PanelScreen Select SelectOverlay {
    background: $bg;
    border: none;
    max-height: 12;
    scrollbar-size: 0 0;
}

PanelScreen Select SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

/* Ends the theme dropdown where the account one ends, before Sign out and its margin */
PanelScreen #theme-selector {
    margin-right: 16;
}

PanelScreen #settings-email {
    width: 1fr;
}

PanelScreen #btn-sign-out {
    width: 14;
    min-width: 0;
    height: 1;
    border: none;
    margin: 0 0 0 2;
    padding: 0 2;
    background: $comment 30%;
    color: $fg;
}

PanelScreen #btn-sign-out:hover {
    background: $comment 50%;
}

PanelScreen #btn-sign-out:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

PanelScreen #settings-separator {
    height: 1;
    color: $comment;
    margin-bottom: 1;
}

PanelScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

PanelScreen #shortcuts-sections {
    height: auto;
}

PanelScreen .shortcuts-section {
    height: auto;
}

PanelScreen #shortcuts-actions {
    width: 1fr;
    margin-right: 2;
}

PanelScreen #shortcuts-general {
    width: 1fr;
}

PanelScreen .shortcut-row {
    height: 1;
}

PanelScreen .shortcut-key {
    width: 8;
    color: $green;
}

PanelScreen .shortcut-desc {
    color: $fg;
}

PanelScreen #panel-footer-spacer {
    height: 1;
}

PanelScreen #panel-footer {
    height: 1;
    align: left middle;
}

PanelScreen #panel-footer .spacer {
    width: 1fr;
}

/* Neutral, like a dialog's cancel button: closing is neither an action nor a danger */
PanelScreen #btn-close {
    width: auto;
    min-width: 0;
    height: 1;
    margin: 0;
    border: none;
    padding: 0 2;
    background: $bg-light;
    color: $fg;
}

PanelScreen #btn-close:hover {
    background: $gutter;
}

PanelScreen #btn-close:focus {
    background: $comment;
    color: $bg-dark;
    text-style: bold;
}

PanelScreen #panel-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

PanelScreen #panel-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

PanelScreen #panel-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}
