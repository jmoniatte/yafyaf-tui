/* ═══════════════════════════════════════════════════════════════════════
   BASE STYLES - Layout and structure (colors come from theme)
   ═══════════════════════════════════════════════════════════════════════ */

Screen {
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen {
    border: none;
}

/* ═══════════════════════════════════════════════════════════════════════
   APP HEADER
   ═══════════════════════════════════════════════════════════════════════ */

#app-header {
    dock: top;
    height: auto;
    background: $bg;
    padding: 0 1;
    border-bottom: solid $gutter;
    margin: 0 0 1 0;
}

#app-title-group {
    width: auto;
    height: auto;
}

#header-spacer {
    width: 1fr;
}

.header-notification-spacer {
    width: 1fr;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $blue;
    background: transparent;
}

#app-title:hover {
    color: $blue;
    text-style: bold underline;
    background: transparent;
}

#app-subtitle {
    width: auto;
    color: $comment;
}

#app-url {
    width: auto;
    color: $yellow;
}

#btn-sign-out {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin-left: 2;
    background: $comment 30%;
    color: $fg;
}

#btn-sign-out:hover {
    background: $comment 50%;
}

HeaderNotification {
    width: 40%;
    height: auto;
    max-height: 2;
    padding: 0 1;
}

HeaderNotification.-information {
    color: $green;
}

HeaderNotification.-warning {
    color: $yellow;
}

/* An extra line so a failed save's kept-draft path is not cut off */
HeaderNotification.-error {
    max-height: 3;
    color: $red;
}

/* ═══════════════════════════════════════════════════════════════════════
   MAIN AREA
   ═══════════════════════════════════════════════════════════════════════ */

#yafs-view {
    padding: 0 1;
    height: 1fr;
}

#yafs-controls {
    height: auto;
    margin-bottom: 1;
    background: transparent;
}

#yafs-view #search {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

#yafs-view #search:focus {
    border: solid $blue;
}

/* The search box is 3 rows with its border; the top margin lines the button up with its text */
#yafs-controls Button {
    margin: 1 0 0 3;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 2;
}

#btn-new-yaf {
    background: $blue 30%;
    color: $blue;
}

#btn-new-yaf:hover {
    background: $blue 50%;
}

#btn-new-yaf:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

#yafs-table {
    height: 1fr;
    background: transparent;
    /* The theme's text color, like Flotte; Textual's default is near white */
    color: $fg;
    scrollbar-size-vertical: 1;
    /* Same scrollbar colors as Flotte */
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
    overflow-x: hidden;
}

#yafs-table > .datatable--cursor {
    background: $bg-light;
    color: auto;
    text-style: none;
}

#yafs-table > .datatable--hover {
    background: transparent;
}

#yafs-header {
    height: 1;
    color: $comment;
}

#yafs-header-rule {
    height: 1;
    color: $comment;
}

#yafs-header-summary {
    width: 1fr;
}

#yafs-status {
    width: auto;
}

#status-line {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   HELP SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

HelpScreen {
    align: center top;
    background: $bg 80%;
}

HelpScreen > Vertical {
    width: auto;
    min-width: 64;
    max-width: 70;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

HelpScreen Static {
    color: $fg;
}

HelpScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

HelpScreen #title-separator {
    height: 1;
}

HelpScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

HelpScreen #help-sections {
    height: auto;
}

HelpScreen .help-section {
    height: auto;
}

HelpScreen #help-actions {
    width: 32;
    margin-right: 2;
}

HelpScreen #help-general {
    width: 32;
}

HelpScreen .shortcut-row {
    height: 1;
}

HelpScreen .shortcut-key {
    width: 8;
    color: $green;
}

HelpScreen .shortcut-desc {
    color: $fg;
}

HelpScreen #help-footer-spacer {
    height: 1;
}

HelpScreen #help-footer {
    height: 1;
    align: right middle;
}

HelpScreen #help-footer .spacer {
    width: 1fr;
}

HelpScreen #help-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

HelpScreen #help-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

HelpScreen #help-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   MODAL FORMS
   ═══════════════════════════════════════════════════════════════════════ */

ModalScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

ModalScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

ModalScreen .form-row {
    height: 3;
    align: left middle;
}

ModalScreen .field-label {
    width: 10;
    padding-top: 1;
    color: $fg;
}

ModalScreen Input {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen Input:focus {
    border: solid $blue;
}

ModalScreen #dialog-buttons {
    height: auto;
    align: right middle;
}

ModalScreen Button {
    width: auto;
    min-width: 0;
    margin: 1 0 0 1;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

ModalScreen Button:focus {
    background: $blue;
    color: $bg-dark;
}

ModalScreen Button:disabled {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONFIRM DIALOG
   ═══════════════════════════════════════════════════════════════════════ */

ConfirmDialog {
    align: center top;
    background: $bg 80%;
}

ConfirmDialog > Vertical {
    width: auto;
    min-width: 40;
    max-width: 60;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

ConfirmDialog #dialog-title {
    text-style: bold;
    color: $red;
    margin-bottom: 1;
}

ConfirmDialog #dialog-message {
    color: $fg;
}

ConfirmDialog #dialog-detail {
    margin-top: 1;
    color: $comment;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ConfirmDialog #dialog-buttons {
    height: 1;
    align: right middle;
    margin-top: 1;
}

ConfirmDialog Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

ConfirmDialog #cancel-btn {
    background: $bg-light;
    color: $fg;
}

ConfirmDialog #cancel-btn:hover {
    background: $gutter;
}

ConfirmDialog #cancel-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

ConfirmDialog #confirm-btn {
    background: $red 30%;
    color: $red;
}

ConfirmDialog #confirm-btn:hover {
    background: $red 50%;
}

ConfirmDialog #confirm-btn:focus {
    background: $red;
    color: white;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGIN SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

LoginScreen {
    align: center top;
    background: $bg 80%;
}

LoginScreen #login-url {
    color: $comment;
    margin: 1 0;
}

LoginScreen #login-error {
    height: auto;
    min-height: 1;
    color: $red;
    margin-top: 1;
}
