/* ═══════════════════════════════════════════════════════════════════════
   BASE STYLES - Layout and structure (colors come from theme)
   ═══════════════════════════════════════════════════════════════════════ */

Screen {
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen {
    border: none;
}

/* ═══════════════════════════════════════════════════════════════════════
   APP HEADER
   ═══════════════════════════════════════════════════════════════════════ */

#app-header {
    dock: top;
    height: auto;
    background: $bg;
    padding: 0 1;
    border-bottom: solid $gutter;
    margin: 0 0 1 0;
}

#app-title-group {
    width: auto;
    height: auto;
}

#header-spacer {
    width: 1fr;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $blue;
    background: transparent;
}

#app-title:hover {
    color: $blue;
    text-style: bold underline;
    background: transparent;
}

#app-subtitle {
    width: auto;
    color: $comment;
}

#app-url {
    width: auto;
    color: $yellow;
}

/* ═══════════════════════════════════════════════════════════════════════
   MAIN AREA
   ═══════════════════════════════════════════════════════════════════════ */

#yafs-view {
    padding: 0 1;
    height: 1fr;
}

#yafs-view #search {
    width: 100%;
    background: $bg;
    color: $fg;
    border: solid $gutter;
    margin-bottom: 1;
}

#yafs-view #search:focus {
    border: solid $blue;
}

#yafs-table {
    height: 1fr;
    background: transparent;
    scrollbar-size-vertical: 1;
    overflow-x: hidden;
}

#yafs-table > .datatable--header {
    background: transparent;
    color: $comment;
    text-style: none;
}

#yafs-table > .datatable--header-hover {
    background: transparent;
    color: $comment;
    text-style: none;
}

#yafs-table > .datatable--cursor {
    background: $bg-light;
    color: auto;
    text-style: none;
}

#yafs-table > .datatable--hover {
    background: transparent;
}

#yafs-status {
    height: 1;
    color: $comment;
    margin-top: 1;
}

/* ═══════════════════════════════════════════════════════════════════════
   YAF DETAIL
   ═══════════════════════════════════════════════════════════════════════ */

#yaf-detail-meta {
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

#yaf-detail-date {
    width: auto;
    color: $yellow;
    text-style: bold;
}

#yaf-detail-edited {
    width: 1fr;
    color: $comment;
    text-align: right;
}

#yaf-detail-body {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#yaf-detail-body:focus {
    border: none;
}

#yaf-detail-content {
    background: transparent;
    padding: 0;
    margin: 0;
}

#yaf-detail-content MarkdownH1,
#yaf-detail-content MarkdownH2,
#yaf-detail-content MarkdownH3 {
    text-align: left;
    content-align: left middle;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 0 1 0;
    color: $blue;
}

#status-line {
    dock: bottom;
    height: 1;
    padding: 0 1;
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   HELP SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

HelpScreen {
    align: center top;
    background: $bg 80%;
}

HelpScreen > Vertical {
    width: auto;
    min-width: 64;
    max-width: 70;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

HelpScreen Static {
    color: $fg;
}

HelpScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

HelpScreen #title-separator {
    height: 1;
}

HelpScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

HelpScreen #help-sections {
    height: auto;
}

HelpScreen .help-section {
    height: auto;
}

HelpScreen #help-actions {
    width: 32;
    margin-right: 2;
}

HelpScreen #help-general {
    width: 32;
}

HelpScreen .shortcut-row {
    height: 1;
}

HelpScreen .shortcut-key {
    width: 8;
    color: $green;
}

HelpScreen .shortcut-desc {
    color: $fg;
}

HelpScreen #help-footer-spacer {
    height: 1;
}

HelpScreen #help-footer {
    height: 1;
    align: right middle;
}

HelpScreen #help-footer .spacer {
    width: 1fr;
}

HelpScreen #help-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

HelpScreen #help-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

HelpScreen #help-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   MODAL FORMS
   ═══════════════════════════════════════════════════════════════════════ */

ModalScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

ModalScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

ModalScreen .form-row {
    height: 3;
    align: left middle;
}

ModalScreen .field-label {
    width: 10;
    padding-top: 1;
    color: $fg;
}

ModalScreen Input {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen Input:focus {
    border: solid $blue;
}

ModalScreen #dialog-buttons {
    height: auto;
    align: right middle;
}

ModalScreen Button {
    width: auto;
    min-width: 0;
    margin: 1 0 0 1;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

ModalScreen Button:focus {
    background: $blue;
    color: $bg-dark;
}

ModalScreen Button:disabled {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGIN SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

LoginScreen {
    align: center top;
    background: $bg 80%;
}

LoginScreen #login-url {
    color: $comment;
    margin: 1 0;
}

LoginScreen #login-error {
    height: auto;
    min-height: 1;
    color: $red;
    margin-top: 1;
}
