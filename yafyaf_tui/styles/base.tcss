/* ═══════════════════════════════════════════════════════════════════════
   BASE STYLES - Layout and structure (colors come from theme)
   ═══════════════════════════════════════════════════════════════════════ */

Screen {
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen {
    border: none;
}

/* ═══════════════════════════════════════════════════════════════════════
   APP HEADER
   ═══════════════════════════════════════════════════════════════════════ */

#app-header {
    dock: top;
    height: auto;
    background: $bg;
    padding: 0 1;
    border-bottom: solid $gutter;
}

#app-title-group {
    width: auto;
    height: auto;
}

#header-spacer {
    width: 1fr;
}

.header-notification-spacer {
    width: 1fr;
}

#app-title {
    width: auto;
    text-style: bold;
    color: $blue;
    background: transparent;
}

#app-title:hover {
    color: $blue;
    text-style: bold underline;
    background: transparent;
}

#app-subtitle {
    width: auto;
    color: $comment;
}

#app-url {
    width: auto;
    color: $yellow;
}

/* The account is the way into Settings with the mouse, so it reads as a link */
#app-account {
    width: auto;
    margin-left: 2;
    color: $blue;
}

#app-account:hover {
    text-style: underline;
}

HeaderNotification {
    width: 40%;
    height: auto;
    max-height: 2;
    padding: 0 1;
}

HeaderNotification.-information {
    color: $green;
}

HeaderNotification.-warning {
    color: $yellow;
}

/* An extra line so a failed save's kept-draft path is not cut off */
HeaderNotification.-error {
    max-height: 3;
    color: $red;
}

/* ═══════════════════════════════════════════════════════════════════════
   MAIN AREA
   ═══════════════════════════════════════════════════════════════════════ */

#main-area {
    height: 1fr;
}

#yafs-view {
    padding: 0 1;
    height: 1fr;
}

#yafs-controls {
    height: auto;
    background: transparent;
}

#yafs-view #search {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

#yafs-view #search:focus {
    border: solid $blue;
}

/* The search box is 3 rows with its border; the top margin lines the button up with its text */
#yafs-controls Button {
    margin: 1 0 0 3;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 2;
}

#btn-new-yaf {
    background: $blue 30%;
    color: $blue;
}

#btn-new-yaf:hover {
    background: $blue 50%;
}

#btn-new-yaf:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

#yafs-table {
    height: 1fr;
    background: transparent;
    /* The theme's text color, like Flotte; Textual's default is near white */
    color: $fg;
    scrollbar-size-vertical: 1;
    /* Same scrollbar colors as Flotte */
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
    overflow-x: hidden;
}

#yafs-table > .datatable--cursor {
    background: $bg-light;
    color: auto;
    text-style: none;
}

#yafs-table > .datatable--hover {
    background: transparent;
}

#yafs-header {
    height: 1;
    color: $comment;
}

#yafs-header-rule {
    height: 1;
    color: $comment;
}

#yafs-header-summary {
    width: 1fr;
}

#yafs-status {
    width: auto;
}

/* ═══════════════════════════════════════════════════════════════════════
   YAF DETAIL - one yaf as markdown, shown in place of the list
   ═══════════════════════════════════════════════════════════════════════ */

#yaf-detail {
    display: none;
    height: 1fr;
}

#yaf-detail-scroll {
    height: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-background: $bg;
    scrollbar-background-hover: $bg;
    scrollbar-background-active: $bg;
    scrollbar-color: $gutter;
    scrollbar-color-hover: $comment;
    scrollbar-color-active: $blue;
}

/* The full date and the API id take the saying's place under the content */
#yaf-detail-footer {
    height: 2;
    padding: 0 1;
    border-top: solid $gutter;
    color: $comment;
}

#yaf-detail-date {
    width: 1fr;
}

#yaf-detail-id {
    width: auto;
}

/* Textual's markdown styles use its own theme variables; map them onto the palette */
#yaf-detail-markdown {
    padding: 0;
    color: $fg;
}

/* Link styles do not inherit, so they go on the blocks that hold the text */
#yaf-detail-markdown MarkdownBlock {
    link-color: $blue;
    link-background: transparent;
    link-style: none;
    link-color-hover: $blue;
    link-background-hover: transparent;
    link-style-hover: underline;
}

#yaf-detail-markdown MarkdownHeader {
    color: $yellow;
    text-style: bold;
    margin: 1 0 1 0;
}

#yaf-detail-markdown MarkdownH1 {
    content-align: left middle;
    background: transparent;
    margin: 0 0 1 0;
}

#yaf-detail-markdown MarkdownBlock > .code_inline {
    background: $bg-light;
    color: $fg;
}

#yaf-detail-markdown MarkdownFence {
    background: $bg-dark;
}

#yaf-detail-markdown MarkdownBlockQuote {
    background: $bg-dark;
    border-left: outer $comment;
}

#yaf-detail-markdown MarkdownHorizontalRule {
    color: $gutter;
}

/* Shown in place of the list while the server cannot be used */
#offline {
    display: none;
    height: 1fr;
    padding: 0 1;
    align: center middle;
}

#offline-title {
    width: auto;
    text-style: bold;
    color: $red;
}

#offline-detail {
    width: auto;
    margin-top: 1;
    color: $comment;
}

#btn-retry {
    width: auto;
    min-width: 0;
    margin-top: 2;
    border: none;
    padding: 0 2;
    background: $blue 30%;
    color: $blue;
}

#btn-retry:hover {
    background: $blue 50%;
}

/* ═══════════════════════════════════════════════════════════════════════
   ECHO
   ═══════════════════════════════════════════════════════════════════════ */

/* In flow under the list rather than docked, so it sits above the status line when that shows */
#echo {
    height: 2;
    padding: 0 1;
    border-top: solid $gutter;
    color: $comment;
    text-style: italic;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The score sits in the header, left of the account */
#echo-score {
    width: auto;
    margin-left: 2;
    color: $green;
}

/* ═══════════════════════════════════════════════════════════════════════
   SETTINGS SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

SettingsScreen {
    align: center top;
    background: $bg 80%;
}

SettingsScreen > Vertical {
    width: auto;
    min-width: 84;
    max-width: 90;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

SettingsScreen Static {
    color: $fg;
}

SettingsScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

SettingsScreen #title-separator {
    height: 1;
}

SettingsScreen .settings-row {
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

SettingsScreen .settings-label {
    width: 10;
    color: $comment;
}

SettingsScreen Select {
    width: 1fr;
    height: 1;
}

SettingsScreen Select SelectCurrent {
    background: transparent;
    border: none !important;
    padding: 0;
    color: $fg;
}

SettingsScreen Select SelectCurrent:hover,
SettingsScreen Select:focus SelectCurrent {
    color: $blue;
}

SettingsScreen Select SelectOverlay {
    background: $bg;
    border: none;
    max-height: 12;
    scrollbar-size: 0 0;
}

SettingsScreen Select SelectOverlay > .option-list--option-highlighted {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

SettingsScreen #settings-email {
    width: 1fr;
}

SettingsScreen #btn-sign-out {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    margin: 0 0 0 2;
    padding: 0 2;
    background: $comment 30%;
    color: $fg;
}

SettingsScreen #btn-sign-out:hover {
    background: $comment 50%;
}

SettingsScreen #btn-sign-out:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

SettingsScreen #settings-separator {
    height: 1;
    color: $comment;
    margin-bottom: 1;
}

SettingsScreen .section-title {
    text-style: bold;
    color: $fg;
    border-bottom: ascii $gutter;
}

SettingsScreen #shortcuts-sections {
    height: auto;
}

SettingsScreen .shortcuts-section {
    height: auto;
}

SettingsScreen #shortcuts-actions {
    width: 1fr;
    margin-right: 2;
}

SettingsScreen #shortcuts-general {
    width: 1fr;
}

SettingsScreen .shortcut-row {
    height: 1;
}

SettingsScreen .shortcut-key {
    width: 8;
    color: $green;
}

SettingsScreen .shortcut-desc {
    color: $fg;
}

SettingsScreen #settings-footer-spacer {
    height: 1;
}

SettingsScreen #settings-footer {
    height: 1;
    align: right middle;
}

SettingsScreen #settings-footer .spacer {
    width: 1fr;
}

SettingsScreen #settings-version {
    width: auto;
    margin-left: 1;
    color: $comment;
}

SettingsScreen #settings-repository {
    width: auto;
    color: $blue;
    background: transparent;
}

SettingsScreen #settings-repository:hover {
    color: $blue;
    text-style: underline;
    background: transparent;
}

/* ═══════════════════════════════════════════════════════════════════════
   MODAL FORMS
   ═══════════════════════════════════════════════════════════════════════ */

ModalScreen > Vertical {
    width: 60;
    height: auto;
    max-height: 80%;
    background: $bg-dark;
    border: none;
    padding: 1 2;
    margin-top: 4;
}

ModalScreen #dialog-title {
    text-style: bold;
    color: $blue;
    border-bottom: ascii $gutter;
}

ModalScreen .form-row {
    height: 3;
    align: left middle;
}

ModalScreen .field-label {
    width: 10;
    padding-top: 1;
    color: $fg;
}

ModalScreen Input {
    width: 1fr;
    background: $bg;
    color: $fg;
    border: solid $gutter;
}

ModalScreen Input:focus {
    border: solid $blue;
}

ModalScreen #dialog-buttons {
    height: auto;
    align: right middle;
}

ModalScreen Button {
    width: auto;
    min-width: 0;
    margin: 1 0 0 1;
    padding: 0 2;
    border: none;
    background: $bg-light;
    color: $fg;
}

ModalScreen Button:focus {
    background: $blue;
    color: $bg-dark;
}

ModalScreen Button:disabled {
    color: $comment;
}

/* ═══════════════════════════════════════════════════════════════════════
   CONFIRM DIALOG
   ═══════════════════════════════════════════════════════════════════════ */

ConfirmDialog {
    align: center top;
    background: $bg 80%;
}

ConfirmDialog > Vertical {
    width: auto;
    min-width: 40;
    max-width: 60;
    background: $bg-dark;
    border: none;
    padding: 1 2;
}

ConfirmDialog #dialog-title {
    text-style: bold;
    color: $red;
    margin-bottom: 1;
}

ConfirmDialog #dialog-message {
    color: $fg;
}

ConfirmDialog #dialog-detail {
    margin-top: 1;
    color: $comment;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

ConfirmDialog #dialog-buttons {
    height: 1;
    align: right middle;
    margin-top: 1;
}

ConfirmDialog Button {
    width: auto;
    min-width: 0;
    border: none;
    margin: 0 0 0 1;
    padding: 0 2;
}

ConfirmDialog #cancel-btn {
    background: $bg-light;
    color: $fg;
}

ConfirmDialog #cancel-btn:hover {
    background: $gutter;
}

ConfirmDialog #cancel-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

ConfirmDialog #confirm-btn {
    background: $red 30%;
    color: $red;
}

ConfirmDialog #confirm-btn:hover {
    background: $red 50%;
}

ConfirmDialog #confirm-btn:focus {
    background: $red;
    color: white;
    text-style: bold;
}

ConfirmDialog #edit-btn,
ConfirmDialog #retry-btn {
    background: $blue 30%;
    color: $blue;
}

ConfirmDialog #edit-btn:hover,
ConfirmDialog #retry-btn:hover {
    background: $blue 50%;
}

ConfirmDialog #edit-btn:focus,
ConfirmDialog #retry-btn:focus {
    background: $blue;
    color: $bg-dark;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════════
   LOGIN SCREEN
   ═══════════════════════════════════════════════════════════════════════ */

LoginScreen {
    align: center top;
    background: $bg 80%;
}

LoginScreen #login-url {
    color: $comment;
    margin: 1 0;
}

LoginScreen #login-error {
    height: auto;
    min-height: 1;
    color: $red;
    margin-top: 1;
}

/* ═══════════════════════════════════════════════════════════════════════
   THEME PICKER
   ═══════════════════════════════════════════════════════════════════════ */

ThemePicker {
    align: center top;
    background: $bg 80%;
}

ThemePicker > Vertical {
    width: 54;
    height: 1fr;
    max-height: 100%;
    margin-top: 2;
    margin-bottom: 2;
}

ThemePicker #theme-filter {
    width: 1fr;
    height: 2;
    margin: 0 0 1 0;
    padding: 0;
    background: transparent;
    color: $fg;
    border: none !important;
    border-bottom: solid $gutter !important;
}

ThemePicker #theme-filter:focus {
    border-bottom: solid $blue !important;
}

ThemePicker #theme-table {
    height: 1fr;
    background: transparent;
    border: none;
    color: $fg;
    scrollbar-size: 0 0;
}

ThemePicker #theme-table > .datatable--cursor {
    background: $bg-light;
    color: $fg;
    text-style: none;
}

ThemePicker #theme-table > .datatable--hover {
    background: transparent;
}

ThemePicker #theme-hint {
    color: $comment;
    margin-top: 1;
    border-top: ascii $gutter;
    padding-top: 1;
}
