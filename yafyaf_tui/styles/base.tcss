/* ═══════════════════════════════════════════════════════════════════════
   BASE STYLES - where yafyaf's differ from ouikit's
   ═══════════════════════════════════════════════════════════════════════ */

/* A full-size app rather than a pop-up, so it draws its own frame */
Screen {
    border: solid $gutter;
}

ModalScreen {
    border: none;
}
