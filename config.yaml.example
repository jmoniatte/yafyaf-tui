# ~/.config/yafyaf-tui/config.yaml

# Color theme: onedark or onelight
theme: onedark

# Base URL of the YafYaf instance
url: http://localhost:3000

# The API token is not kept here. The TUI asks for your email and password on
# first start and saves the token it gets to ~/.config/yafyaf-tui/token (mode 600).
